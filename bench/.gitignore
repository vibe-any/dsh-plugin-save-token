# Derived / heavyweight artifacts — everything needed to reproduce is either
# committed here or rebuildable via bench/scripts + bench/README.md.

# Python byte-code
__pycache__/
*.pyc

# uv cache created during episode prep
.uv-cache/

# SWE repo trees are derived from pinned upstream commits (see bench/README.md);
# a full checkout is ~310 MB with .base/.pristine/venv variants.
sandboxes/swe/

# Canonical JSONL corpus is committed gzipped (~12 MB); raw files are
# regenerated by scripts/prep_episode.sh on demand.
sandboxes/tb-jsonl-aggregator/initial/*.jsonl

# terminal-bench upstream checkout (169 MB) — fetch per bench/README.md
datasets/tb2/
# Full mirror tarball of the same checkout
datasets/tb_mirror.tar.gz
